---
import slugify from "@sindresorhus/slugify";
import { getCollection } from "astro:content";
import CommandPage from "../../components/CommandPage.astro";

export async function getStaticPaths() {
    const cmds = await getCollection("commands");
    return cmds.map((cmd) => ({
        params: { id: cmd.id },
        props: { cmd: { ...cmd.data } },
    }));
}

const { cmd } = Astro.props;
const categorySlug = slugify(cmd.category);
---

<CommandPage {cmd} backlinkSlug={categorySlug} />
