---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";

import { Aside, Code } from "@astrojs/starlight/components";

import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const cmds = await getCollection("commands");
    return cmds.map((cmd) => ({
        params: { id: cmd.id },
        props: { cmd },
    }));
}

const { cmd } = Astro.props;
---

<StarlightPage frontmatter={{ title: cmd.data.name }}>
    <p>{cmd.data.description}</p>

    {
        cmd.data.type === "plugin" && (
            <Aside type="note" title="Plugin Command">
                <p>
                    This command is provided by an official Nushell plugin and
                    will only work if you've previously run the following
                    command with the correct plugin name:
                </p>
                <Code
                    code={`plugin add ${cmd.data.plugin_file || "nu_plugin_{name}"}`}
                    lang="nushell"
                    mark="nu_plugin_{name}"
                />
            </Aside>
        )
    }

    {cmd.data.extra_description && <p>{cmd.data.extra_description}</p>}

    <AnchorHeading id="signature" level="2">Signature</AnchorHeading>

    <Code code={cmd.data.sig_str} frame="none" />

    <hr />
    <footer>
        {
            (cmd.data.search_terms && (
                <p>
                    <b>Search Terms:</b>&nbsp;
                    <span>{cmd.data.search_terms}</span>
                </p>
            )) || <p>No search terms provided.</p>
        }
        <p>
            <b>Category:</b>&nbsp;
            <a href={`/commands/#${cmd.data.category}`}>
                {cmd.data.category}
            </a>
        </p>
    </footer>
</StarlightPage>

<style>
    footer {
        display: flex;
        align-items: baseline;
        gap: 2em;
        flex-wrap: wrap;
        & > * {
            /* Set by Astro for some reason */
            margin-top: auto;
        }
    }
</style>
