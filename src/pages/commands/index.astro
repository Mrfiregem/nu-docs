---
import slugify from "@sindresorhus/slugify";

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";

import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import { Aside } from "@astrojs/starlight/components";

const allCmds = await getCollection("commands");
const sortedCmds = allCmds
    .sort(
        (a, b) =>
            a.data.category.localeCompare(b.data.category) ||
            a.id.localeCompare(b.id),
    )
    .map((cmd) => ({
        ...cmd,
        slugged_category: slugify(cmd.data.category),
    }));
---

<StarlightPage
    frontmatter={{ title: "Nushell Commands" }}
    headings={sortedCmds
        .map((cmd) => {
            const heading: MarkdownHeading = {
                depth: 2,
                slug: cmd.slugged_category,
                text: cmd.data.category,
            };
            return heading;
        })
        .filter(
            (item, index, self) =>
                index === self.findIndex((t) => t.slug === item.slug),
        )}
>
    <Aside title="Plugin commands" type="tip" icon="information">
        Commands annotated with a (&dagger;) require a plugin to be installed to
        use them. Go to their command page and look for a box like this to see
        which plugin is required to use that command.
    </Aside>

    <dl id="command-list" class="not-content">
        {
            sortedCmds.map((cmd, index) => {
                const isNewCategory =
                    cmd.data.category !== sortedCmds[index - 1]?.data.category;
                return (
                    <Fragment key={cmd.id}>
                        {isNewCategory && (
                            <AnchorHeading level="2" id={cmd.slugged_category}>
                                {cmd.data.category}
                            </AnchorHeading>
                        )}
                        <dt>
                            <a
                                href={`/nu-docs/commands/${cmd.id}/`}
                                class:list={[
                                    { deprecated: cmd.data.deprecated },
                                ]}
                            >
                                {cmd.data.name}
                            </a>
                            {cmd.data.type === "plugin" && (
                                <sup title="This command requires a plugin to be installed">
                                    &dagger;
                                </sup>
                            )}
                        </dt>
                        <dd>{cmd.data.description}</dd>
                    </Fragment>
                );
            })
        }
    </dl>
</StarlightPage>

<style>
    .deprecated {
        text-decoration: line-through;
    }
    /* Show description below command name if there's not room */
    @container --sl-container (width <= 640px) {
        dt {
            margin-block-start: 1em;
        }
        dd {
            margin-inline-start: 3ch;
        }
    }
    /* Otherwise, show them both on the same row, aligned */
    @container --sl-container (width > 640px) {
        #command-list {
            display: grid;
            grid-template-columns: [header-start] max-content 1fr [header-end];
            gap: 0.5em 2ch;
            max-width: 100%;

            .sl-heading-wrapper {
                grid-column: header;
            }
            dt {
                grid-column: 1;
            }
            dd {
                grid-column: 2;
            }
        }
    }
</style>
