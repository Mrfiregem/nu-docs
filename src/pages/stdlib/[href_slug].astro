---
import { Badge, Code } from "@astrojs/starlight/components";
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import slugify from "@sindresorhus/slugify";
import { getCollection } from "astro:content";
import linkifyHtml from "linkify-html";

export async function getStaticPaths() {
    const libs = await getCollection("stdlib");
    const lib_cmds = libs.flatMap((lib) =>
        lib.data.commands.map((cmd) => ({
            ...cmd,
            module: lib.data.module,
            library: lib.data.library,
            fullModule: lib.data.library + "/" + lib.data.module,
            href_slug: slugify(lib.data.library + "-" + cmd.name),
            id: slugify(lib.id + "-" + cmd.id),
        })),
    );
    return lib_cmds.map((cmd) => ({
        params: { href_slug: cmd.href_slug },
        props: { cmd },
    }));
}

const { cmd } = Astro.props;
const fullModuleSlug = slugify(cmd.fullModule);
---

<StarlightPage frontmatter={{ title: `${cmd.library}/${cmd.name}` }}>
    <p>{cmd.description}</p>

    {
        cmd.extra_description && (
            <>
                <hr />
                <div id="extra_desc">
                    {/* Split extra description into sentences separated by newlines and punctuation */}
                    {cmd.extra_description.split(/\r?\n/).map((sentence) => (
                        <p set:html={linkifyHtml(sentence)} />
                    ))}
                </div>
            </>
        )
    }

    <AnchorHeading id="signature" level="2">Signature</AnchorHeading>

    <Code code={cmd.signature_string} frame="none" />

    <AnchorHeading id="input-output" level="3">
        Input / Output Types
    </AnchorHeading>

    <div class="input-output-list not-content">
        {
            cmd.input_output_pairs.map(({ input, output }) => (
                <>
                    <div class="input">{input}</div>
                    <div class="eq">&rarr;</div>
                    <div class="output">{output}</div>
                </>
            ))
        }
    </div>

    <AnchorHeading id="flags" level="3">Command Flags</AnchorHeading>

    {
        cmd.flags.length > 0 ? (
            <dl id="flag-list">
                {cmd.flags.map(
                    ({
                        parameter_name: name,
                        parameter_type: type,
                        description,
                        is_optional: opt,
                        short_flag,
                        syntax_shape,
                        parameter_default: default_val,
                    }) => {
                        let result = `--${name}`;
                        if (short_flag) {
                            result = `-${short_flag}, ${result}`;
                        }
                        if (type == "named") {
                            result += `: ${syntax_shape}`;
                        }
                        if (default_val) {
                            result += ` = ${default_val}`;
                        }
                        return (
                            <>
                                <dt class="flag-key">
                                    {result}
                                    {opt && syntax_shape ? (
                                        <Badge text="Optional" variant="note" />
                                    ) : (
                                        opt && (
                                            <Badge
                                                text="Switch"
                                                variant="note"
                                            />
                                        )
                                    )}
                                </dt>
                                <dd class="flag-val">{description}</dd>
                            </>
                        );
                    },
                )}
            </dl>
        ) : (
            <p>This command does not accept any flags.</p>
        )
    }

    <AnchorHeading id="positionals" level="3">
        Positional Arguments
    </AnchorHeading>

    {
        cmd.positionals.length > 0 ? (
            <dl>
                {cmd.positionals.map((pos) => {
                    let result =
                        pos.parameter_type === "rest"
                            ? "...rest"
                            : (pos.parameter_name ?? "positional");
                    result += `: ${pos.syntax_shape}`;
                    if (pos.parameter_default) {
                        result += ` = ${pos.parameter_default}`;
                    }
                    return (
                        <>
                            <dt class="pos-key">
                                {result}
                                {pos.is_optional && (
                                    <Badge text="Optional" variant="note" />
                                )}
                            </dt>
                            <dd>{pos.description}</dd>
                        </>
                    );
                })}
            </dl>
        ) : (
            <p>This command does not accept any positional arguments.</p>
        )
    }

    <hr />
    <footer>
        {
            cmd.search_terms ? (
                <p>
                    <b>Search Terms:</b>&nbsp;
                    <span>{cmd.search_terms}</span>
                </p>
            ) : (
                <p>No search terms provided.</p>
            )
        }
        <p>
            <b>Module:</b>&nbsp;
            <a href={`/nu-docs/stdlib/#${fullModuleSlug}`}>
                {cmd.fullModule}
            </a>
        </p>
    </footer>
</StarlightPage>

<style>
    .input-output-list {
        --columns: 1;
        display: grid;
        grid-template-columns: repeat(var(--columns), max-content auto 1fr);
        gap: 0 2ch;
        .input::before {
            content: "\2022 ";
            margin-inline-end: 1ch;
        }
    }

    @container --sl-container (width > 480) {
        .input-output-list {
            --columns: 2;
        }
    }

    .flag-key,
    .pos-key {
        display: flex;
        gap: 1ch;
        align-items: baseline;
    }

    footer {
        display: flex;
        align-items: baseline;
        column-gap: 2em;
        flex-wrap: wrap;
    }
</style>
