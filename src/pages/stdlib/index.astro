---
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import slugify from "@sindresorhus/slugify";
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";

const allLibs = await getCollection("stdlib");
const sortedLibCmds = allLibs
    .flatMap((lib) =>
        lib.data.commands.map((cmd) => ({
            ...cmd,
            module: lib.data.module,
            library: lib.data.library,
            fullModule: lib.data.library + "/" + lib.data.module,
            href_slug: slugify(lib.data.library + "-" + cmd.name),
            id: slugify(lib.id + "-" + cmd.id),
        })),
    )
    .sort(
        (a, b) =>
            a.library.localeCompare(b.library) ||
            a.module.localeCompare(b.module) ||
            a.name.localeCompare(b.name),
    );
const headings: MarkdownHeading[] = sortedLibCmds
    .flatMap((cmd, index, self) => {
        const isNewLibrary = cmd.library !== self[index - 1]?.library;
        let result = [
            { depth: 3, slug: slugify(cmd.fullModule), text: cmd.fullModule },
        ];
        if (isNewLibrary) {
            result.unshift({
                depth: 2,
                slug: slugify(cmd.library),
                text: cmd.library,
            });
        }
        return result;
    })
    .filter(
        (item, index, self) =>
            index === self.findIndex((t) => t.slug === item.slug),
    );
---

<StarlightPage frontmatter={{ title: "Nushell Stdlib" }} headings={headings}>
    <div id="stdlib-list" class="not-content">
        {
            sortedLibCmds.map((cmd, index) => {
                const isNewLibrary =
                    cmd.library !== sortedLibCmds[index - 1]?.library;
                const isNewModule =
                    cmd.module !== sortedLibCmds[index - 1]?.module;
                return (
                    <Fragment key={cmd.id}>
                        {isNewLibrary && (
                            <AnchorHeading
                                class="span-cols"
                                level="2"
                                id={slugify(cmd.library)}
                            >
                                {cmd.library}
                            </AnchorHeading>
                        )}
                        {isNewModule && (
                            <AnchorHeading
                                class="span-cols"
                                level="3"
                                id={slugify(cmd.fullModule)}
                            >
                                {cmd.fullModule}
                            </AnchorHeading>
                        )}
                        <div class="cmd-name">
                            <a href={`/nu-docs/stdlib/${cmd.href_slug}`}>
                                {cmd.name}
                            </a>
                        </div>
                        <div class="cmd-desc">{cmd.description}</div>
                    </Fragment>
                );
            })
        }
    </div>
</StarlightPage>

<style>
    @container --sl-container (width <= 640px) {
        .cmd-name {
            margin-block-start: 1em;
        }
        .cmd-desc {
            margin-inline-start: 3ch;
        }
    }
    @container --sl-container (width > 640px) {
        #stdlib-list {
            display: grid;
            grid-template-columns: max-content 1fr;
            max-width: 100%;
            gap: 0.5em 2ch;

            .sl-heading-wrapper {
                grid-column: 1/ -1;
            }
        }
    }
</style>
