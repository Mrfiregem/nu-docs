---
interface Props {
    columns?: number;
    altText?: string;
}
const { columns = 0, altText = "Packaging status" } = Astro.props;

const builder = new URL(
    "https://repology.org/badge/vertical-allrepos/nushell.svg",
);
if (columns > 0) {
    builder.searchParams.set("columns", columns.toString());
}
const img_src = builder.toString();
---

<a href="https://repology.org/project/nushell/versions">
    <img src={img_src} alt={altText} />
</a>
